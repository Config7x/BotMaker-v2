# ---- BotMaker v2 environment (v2.1.0) ----
# توکن ربات کنترل (از @BotFather)
CONTROL_BOT_TOKEN=123456:ABC-YOUR-CONTROL-BOT-TOKEN

# کلید رمزنگاری توکن‌های ربات‌های کاربران (AES-256-GCM)
# حداقل ۳۲ کاراکتر؛ توصیه: ۶۴ کاراکتر HEX => openssl rand -hex 32
ENCRYPTION_KEY=PUT_A_LONG_RANDOM_SECRET_HERE

# آدرس عمومی سرور (HTTPS الزامی؛ برای ثبت وب‌هوک ربات کنترل و ربات‌های کاربران)
PUBLIC_BASE_URL=https://bots.yourdomain.com

# پورت وب‌سرور
PORT=8443

# مسیر دیتابیس
DB_PATH=./data/botmaker.db

# آیدی عددی مالک پلتفرم (کنسول مدیریت)
ADMIN_ID=123456789

# حداکثر ربات هر کاربر
MAX_BOTS_PER_USER=3

# حالت فقط-ادمین؛ برای سرویس چندکاربره false بگذارید
ADMIN_ONLY=false

# ---- قالب‌های کانتینری (§3.10-11، فقط Pro/VIP) ----
# اعتبارنامه‌های Telethon برای قالب اسکرپر کانفیگ
# از https://my.telegram.org بخش API development tools
TELETHON_API_ID=1234567
TELETHON_API_HASH=PUT_YOUR_API_HASH

# راز مشترک اندپوینت هشدار امنیتی داخلی (Falco)
INTERNAL_ALERT_SECRET=PUT_RANDOM_SHARED_SECRET
