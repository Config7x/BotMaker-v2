# ---- BotMaker v2 environment ----
# توکن ربات کنترل (از @BotFather)
CONTROL_BOT_TOKEN=123456:ABC-YOUR-CONTROL-BOT-TOKEN

# کلید رمزنگاری توکن‌های ربات‌های کاربران (AES-256-GCM)
# حداقل ۳۲ کاراکتر؛ توصیه: ۶۴ کاراکتر HEX => openssl rand -hex 32
ENCRYPTION_KEY=PUT_A_LONG_RANDOM_SECRET_HERE

# آدرس عمومی سرور (برای ثبت وب‌هوک ربات‌های کاربران)
PUBLIC_URL=https://bots.yourdomain.com

# پورت وب‌سرور
PORT=8443

# مسیر دیتابیس
DB_PATH=./data/botmaker.db

# آیدی عددی مالک پلتفرم (کنسول مدیریت)
OWNER_TELEGRAM_ID=123456789

# راز مشترک اندپوینت هشدار امنیتی Falco
SECURITY_ALERT_SECRET=PUT_RANDOM_SHARED_SECRET

# قیمت سرویس سورس سفارشی (تومان)
CUSTOM_SOURCE_PRICE=300000

# پوشه نگهداری سورس‌های سفارشی
CUSTOM_SOURCES_DIR=./custom_sources

# gVisor: نصب‌کننده به‌صورت خودکار runsc را چک می‌کند و مقدار را ست می‌کند.
# اگر false باشد اجرای پروژه‌های سفارشی «fail-closed» است و انجام نمی‌شود.
GVISOR_AVAILABLE=false

# حالت تست بدون تلگرام واقعی (هیچ درخواستی به تلگرام زده نمی‌شود)
MOCK_TELEGRAM=false

# ---- قالب کانتینری #۱۱ (اسکرپر کانفیگ) ----
# API_ID و API_HASH از my.telegram.org (مخصوص پلتفرم؛ هرگز از کپی رفرنس استفاده نشود)
TELETHON_API_ID=0
TELETHON_API_HASH=PUT_YOUR_API_HASH
